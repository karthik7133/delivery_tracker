PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<dbname>

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Option A: Brevo HTTP API - Recommended for Render free tier, 300 free emails/day to ANY user with 0 timeouts)
BREVO_API_KEY=xkeysib-your_api_key_here

# Email (Option B: Gmail SMTP / Nodemailer - May experience connection timeouts on Render free tier)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password_here
EMAIL_FROM=Delivery Tracker <your_email@gmail.com>

# Email (Option C: Resend API - Requires custom domain verification)
RESEND_API_KEY=re_123456789
RESEND_FROM=SwiftKart <onboarding@resend.dev>

# SMS
SMS_API_KEY=your_sms_api_key_here

# Admin seed credentials
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@deliverytracker.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_PHONE=9000000000
